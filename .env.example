# Copy this file to  .env  and fill in your keys (setup guide shows where to get each one)

# Free Gemini API key – aistudio.google.com/apikey
GEMINI_API_KEY=

# Meta (Instagram + Facebook) – from the Graph API Explorer steps in the guide
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0

# Optional: Telegram alerts when a video is posted or something fails
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
